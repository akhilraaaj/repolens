# Frontend
# Next.js reads environment files from apps/web, not from the repository root.
# Copy this variable to apps/web/.env.local to override the default.
# The code default is http://127.0.0.1:8000.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# API
# Optional. Comma-separated browser origins allowed to read API responses.
# The code default is http://localhost:3000,http://127.0.0.1:3000.
REPOLENS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection. Required for ingestion, analysis, search, and questions.
# GET /health does not use it.
# docker compose uses user repolens, password repolens, database repolens.
# Do not start Compose while another PostgreSQL already listens on port 5432.
DATABASE_URL=postgresql://localhost:5432/repolens

# Optional. Sent only to api.github.com. Never sent to the browser or to codeload.
# GITHUB_TOKEN=

# Optional positive integers. Defaults are shown.
# REPOLENS_MAX_ARCHIVE_BYTES=104857600
# REPOLENS_MAX_ENTRIES=20000
# REPOLENS_MAX_STORED_FILES=10000
# REPOLENS_MAX_FILE_BYTES=524288
# REPOLENS_MAX_TOTAL_BYTES=67108864
# REPOLENS_MAX_DURATION_SECONDS=180
# REPOLENS_MAX_ANALYSIS_SECONDS=60

# Optional OpenAI-compatible embedding endpoint. When unset, RepoLens uses the
# local model jinaai/jina-embeddings-v2-base-code (768 dimensions). The key stays
# in this process. A hosted model must return 768 numbers.
# REPOLENS_EMBEDDING_BASE_URL=
# REPOLENS_EMBEDDING_MODEL=
# REPOLENS_EMBEDDING_API_KEY=

# Optional cross-encoder. Off unless set to 1. The default model is the small
# jinaai/jina-reranker-v1-tiny-en. Set REPOLENS_RERANKER_MODEL to override it.
# REPOLENS_RERANKER=1
# REPOLENS_RERANKER_MODEL=

# Chat used when the saved provider is None, or when no provider row exists.
# The API loads apps/api/.env on startup. A key there stays out of git.
# Restart the API after editing it. Keys are not returned to the browser.
# REPOLENS_CHAT_BASE_URL=https://openrouter.ai/api/v1
# REPOLENS_CHAT_MODEL=openrouter/free
# REPOLENS_CHAT_API_KEY=
